# Conversational Deal Engine — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

# ── AI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── WhatsApp Business API ────────────────────────────────────────────
# Meta Developer Portal → Your App → WhatsApp → Configuration
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token-here
WHATSAPP_API_SECRET=your-meta-app-secret-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ── Paystack ─────────────────────────────────────────────────────────
# Paystack Dashboard → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/stickerbot

# ── Admin ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ADMIN_BEARER_TOKEN=your-secure-random-token-here

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
