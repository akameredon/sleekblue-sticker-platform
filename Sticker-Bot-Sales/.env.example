# ╔══════════════════════════════════════════════════════════════════╗
# ║  Sticker-Bot-Sales — Environment Config                         ║
# ║  Copy this file:  cp .env.example .env                          ║
# ║  NEVER commit .env to git (it's in .gitignore)                  ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── AI ───────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OPENAI_KEY

# ── Paystack ─────────────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com/#/settings/developer
# Use sk_test_ / pk_test_ for testing, sk_live_ / pk_live_ for production
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_SECRET
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_PAYSTACK_PUBLIC
# Set to your deployed storefront return URL, e.g. https://your-domain/payment/return
PAYSTACK_CALLBACK_URL=https://your-domain/payment/return

# ── Database ─────────────────────────────────────────────────────────
# Replit auto-provides this. For local dev use Neon (neon.tech) free tier:
# https://neon.tech → New Project → Connection string
DATABASE_URL=postgresql://user:password@host:5432/stickerbot?sslmode=require

# ── Admin ────────────────────────────────────────────────────────────
# Any random 32+ character string. Generate: openssl rand -hex 32
ADMIN_BEARER_TOKEN=REPLACE_WITH_SECURE_RANDOM_TOKEN

# ── Customer authentication ──────────────────────────────────────────
# Generate: openssl rand -hex 32. Required in production.
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET

# ── Ports (Replit sets these automatically) ───────────────────────────
PORT=8080
BASE_PATH=/

# ── WhatsApp Cloud API (n8n handles this — only needed if using direct API) ──
# Already configured in n8n credentials. Only set here if adding direct
# WhatsApp messaging from the API server (not required for launch).
WHATSAPP_VERIFY_TOKEN=stickerbotverify
WHATSAPP_API_SECRET=REPLACE_WITH_WHATSAPP_API_SECRET
WHATSAPP_PHONE_NUMBER_ID=1089571974228732

# ── Frontend URL (for CORS in production) ────────────────────────────
# Set to your Replit/Vercel/Railway deployed URL
# FRONTEND_URL=https://your-app.replit.app

# ── Node ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
